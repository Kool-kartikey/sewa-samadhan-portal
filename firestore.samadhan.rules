rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // S.A.M.A.D.H.A.N — Firestore Security Rules (Database: samadhan)
    // University of Delhi South Campus (UDSC) 24/7 Redressal Cell
    // Compliance: DPDP Act 2023, UGC Student Grievance Regulations 2023
    // =========================================================================

    // -------------------------------------------------------------------------
    // Helper Functions & Role Verification
    // -------------------------------------------------------------------------
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin() && getAdminData().role == 'SUPER_ADMIN';
    }

    function isNodalOfficer() {
      return isAdmin() && (getAdminData().role == 'SUPER_ADMIN' || getAdminData().role == 'NODAL_OFFICER');
    }

    function isDeptLiaison(deptCode) {
      return isAdmin() && (
        getAdminData().role == 'SUPER_ADMIN' ||
        getAdminData().role == 'NODAL_OFFICER' ||
        (getAdminData().role == 'DEPT_LIAISON' && getAdminData().departmentCode == deptCode)
      );
    }

    // -------------------------------------------------------------------------
    // Grievances Collection (/grievances/{ticketId})
    // -------------------------------------------------------------------------
    match /grievances/{ticketId} {
      
      // Confidential Read Boundary:
      // Because Spark-tier rules cannot perform server-side secret-key verification for anonymous
      // public queries without exposing records, confidential grievance documents and testimonies
      // are readable ONLY by authenticated department liaisons / Union executives.
      allow read: if isAdmin() && isDeptLiaison(resource.data.department);

      // Creation: Students can register grievances systematically
      allow create: if 
        // 1. Mandatory DPDP Act 2023 Consent must be explicitly affirmed
        request.resource.data.dpdpConsent == true &&
        request.resource.data.dpdpConsentTimestamp is timestamp &&
        
        // 2. Strict Data Minimization, Format & Field Size Bounds
        request.resource.data.trackToken is string &&
        request.resource.data.trackToken.matches('^UDSC-2026-[A-Z]{3,12}-(?:[0-9]{3}|[0-9A-Z]{6,10})$') &&
        request.resource.data.category in ['ACADEMIC', 'HOSTEL', 'INFRASTRUCTURE', 'HARASSMENT_RAGGING', 'LIBRARY', 'TRANSIT_SECURITY', 'FINANCIAL', 'OTHER'] &&
        request.resource.data.status == 'SUBMITTED' &&
        request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
        (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 250)) &&
        (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 4000)) &&
        (!('secretKeyHash' in request.resource.data) || (request.resource.data.secretKeyHash is string && request.resource.data.secretKeyHash.size() == 64)) &&
        
        // 3. Department Scoping (Must be valid South Delhi Campus location)
        request.resource.data.department is string &&
        request.resource.data.department.size() > 0 &&
        request.resource.data.department.size() <= 150 &&
        
        // 4. Anonymous Mode Privacy Verification
        (
          request.resource.data.isAnonymous == false ||
          (
            request.resource.data.isAnonymous == true &&
            (!('studentName' in request.resource.data) || request.resource.data.studentName == null) &&
            (!('studentEmail' in request.resource.data) || request.resource.data.studentEmail == null) &&
            (!('studentPhone' in request.resource.data) || request.resource.data.studentPhone == null)
          )
        );

      // Updates: Restricted strictly to authenticated, department-authorized Union Admins.
      // Unauthenticated thread injection and unauthenticated withdrawal mutations are disabled.
      // Enforces monotonic lifecycle boundaries so RESOLVED / WITHDRAWN_BY_STUDENT cases cannot be reopened.
      allow update: if
        isAdmin() &&
        isDeptLiaison(resource.data.department) &&
        !(resource.data.status in ['RESOLVED', 'WITHDRAWN_BY_STUDENT']) &&
        request.resource.data.status in ['SUBMITTED', 'TRIAGED', 'INVESTIGATING', 'ACTION_PROPOSED', 'RESOLVED', 'WITHDRAWN_BY_STUDENT'] &&
        request.resource.data.trackToken == resource.data.trackToken &&
        request.resource.data.isAnonymous == resource.data.isAnonymous &&
        request.resource.data.category == resource.data.category &&
        (
          resource.data.isAnonymous == false ||
          (
            (!('studentName' in request.resource.data) || request.resource.data.studentName == null) &&
            (!('studentEmail' in request.resource.data) || request.resource.data.studentEmail == null) &&
            (!('studentPhone' in request.resource.data) || request.resource.data.studentPhone == null)
          )
        );

      // Deletes: Completely disallowed. Retained for statutory audit until 30-day purge lifecycle.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Admin Roles & RBAC (/admin_roles/{uid})
    // -------------------------------------------------------------------------
    match /admin_roles/{uid} {
      // Only active Admins or the owner UID can read their own role assignment (prevents admin roster enumeration)
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      // Only active Super-Admin can create or update admin roles
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Authentic Admin Succession Ledger (/admin_succession_ledger/{handoverId})
    // IMMUTABLE AUDIT TRAIL: Append-Only. Updates and Deletes are permanently blocked.
    // -------------------------------------------------------------------------
    match /admin_succession_ledger/{handoverId} {
      allow read: if isAdmin();
      
      // Creation: Requires Super-Admin authorization and signed DPDP statutory oath
      allow create: if 
        isSuperAdmin() &&
        request.resource.data.dpdpOathSigned == true &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.transferorUid == request.auth.uid &&
        request.resource.data.transfereeUid is string &&
        request.resource.data.cryptoSignature is string;

      // STRICT IMMUTABILITY: Neither Super-Admin nor anyone can tamper or delete succession history!
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Anomaly Telemetry & Department Clusters (/anomaly_clusters/{clusterId})
    // -------------------------------------------------------------------------
    match /anomaly_clusters/{clusterId} {
      allow read: if isAdmin();
      allow write: if isNodalOfficer();
    }
  }
}
